// MyFinance — Prisma schema
// Provider: PostgreSQL. Connection comes only from env (local .env / prod Coolify).
// Generator: Prisma 7 `prisma-client` (ESM client emitted to /generated, gitignored).

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (env-only). Prisma 7 no longer
  // accepts `url = env(...)` inside the schema datasource block.
}

// ─────────────────────────────────────────────────────────────────────────────
// User — the single, canonical user model (owned by Better Auth, step 6.2).
// Identity fields (name/email/emailVerified/image) + Session/Account relations
// are generated by `@better-auth/cli generate`. The financial relations below
// (incomes/expenses/goals/categories/prefs) point at this same User, so there
// is exactly ONE users table (mapped to "user"). All FKs cascade on delete.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // Financial data (step 6.1) — owned by this user
  incomes    Income[]
  expenses   Expense[]
  goals      SavingsGoal[]
  categories Category[]
  prefs      UserPrefs?

  @@map("user")
}

// ─────────────────────────────────────────────────────────────────────────────
// Financial data — all owned by a User (onDelete: Cascade, indexed on userId)
// Money is stored as Decimal(12,2); convert to number at the API boundary.
// `date`/`targetDate` are date-only (was "YYYY-MM-DD" strings in localStorage).
// `category` holds the category name (string), matching the chosen Category.name.
// ─────────────────────────────────────────────────────────────────────────────

model Income {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  source    String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  description String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  status      ExpenseStatus @default(Paid)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingsGoal {
  id         String   @id @default(cuid())
  name       String
  icon       String // lucide icon name (string, serialisable)
  saved      Decimal  @db.Decimal(12, 2)
  target     Decimal  @db.Decimal(12, 2)
  targetDate DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Category — real table now (one row per available category, per user).
// `type` discriminates income vs expense. `isDefault` marks the per-user
// defaults seeded at account creation (Salary/Housing/…); users add their own.
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(cuid())
  name      String
  icon      String
  type      CategoryType
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserPrefs — 1-1 with User (Settings page).
// monthlyBudget replaces the hard-coded MONTHLY_BUDGET ($3500).
// ─────────────────────────────────────────────────────────────────────────────

model UserPrefs {
  id            String   @id @default(cuid())
  currency      String   @default("USD")
  language      String   @default("en")
  theme         String   @default("system")
  displayName   String   @default("")
  logoUrl       String?
  avatarUrl     String?
  monthlyBudget Decimal  @default(3500) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CategoryType {
  income
  expense
}

enum ExpenseStatus {
  Paid
  Pending
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
