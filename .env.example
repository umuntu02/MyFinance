# ─── MyFinance environment variables ────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
# Local dev: a local Postgres URL. Prod (Coolify/VPS): set on the server, never here.
# All config is env-only — no values are hard-coded in the app.

# ─── Database (Prisma) ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/myfinance?schema=public"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Encryption/signing secret (min 32 chars). Generate with: openssl rand -base64 32
# Never commit the real value — keep it only in .env (local) / the host (prod).
BETTER_AUTH_SECRET=""
# Base URL of the app.
#   Local: http://localhost:3000
#   Prod (Coolify/VPS): the real domain, e.g. https://myfinance.example.com
BETTER_AUTH_URL="http://localhost:3000"

# ─── Optional OAuth providers ────────────────────────────────────────────────
# Social login is enabled automatically only if BOTH id + secret of a provider
# are set. Leave blank to ship email + password only.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
