# ─── MyFinance environment variables ────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
# Local dev: a local Postgres URL. Prod (Coolify/VPS): set on the server, never here.
# All config is env-only — no values are hard-coded in the app.

# ─── Database (Prisma) ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/myfinance?schema=public"

# ─── Better Auth (filled in at step 6.2) ────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (local: http://localhost:3000 — prod: your domain)
BETTER_AUTH_URL="http://localhost:3000"
